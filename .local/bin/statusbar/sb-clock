#!/bin/sh
# Left click:  toggle between "09:41 PM" and "21:41 - 14"
# Right click: show the year calendar in a small popup terminal

state="${XDG_RUNTIME_DIR:-/tmp}/sb-clock-alt"

case "$BLOCK_BUTTON" in
    1)  if [ -f "$state" ]; then rm -f "$state"; else : > "$state"; fi ;;
    3)  setsid -f st -c floating -g 70x40 -e sh -c 'cal -y --color=always; read -r _' >/dev/null 2>&1 ;;
esac

if [ -f "$state" ]; then
    date '+%H:%M - %d'
else
    date '+%I:%M %p'
fi
