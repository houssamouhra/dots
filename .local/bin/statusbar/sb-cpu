#!/bin/sh
# CPU usage for dwmblocks-async: "󰍛 12%"

read_stat() {
    read -r _ user nice system idle iowait irq softirq steal _ </proc/stat
    total=$((user + nice + system + idle + iowait + irq + softirq + steal))
    idle_all=$((idle + iowait))
}

read_stat
total_1=$total
idle_1=$idle_all

sleep 0.5
read_stat

delta_total=$((total - total_1))
delta_idle=$((idle_all - idle_1))

if [ "$delta_total" -gt 0 ]; then
    printf "󰍛 %d%%\n" $((100 * (delta_total - delta_idle) / delta_total))
else
    printf "󰍛 --\n"
fi
