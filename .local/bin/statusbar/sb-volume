#!/bin/sh
# Volume for dwmblocks-async: "󰕾 65%"
# Usage: sb-volume [up|down|mute]  (for keybindings)

step=5
signal=3

# Read state once
vol=$(pamixer --get-volume)
muted=$(pamixer --get-mute)

refresh() { pkill -RTMIN+"$signal" dwmblocks; }

# Re-read state after a change
update_state() {
  vol=$(pamixer --get-volume)
  muted=$(pamixer --get-mute)
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return

  if [ "$muted" = "true" ] || [ "$vol" -eq 0 ]; then
    notify-send -e -u low \
      -h string:x-canonical-private-synchronous:volume_notif \
      "Volume: Muted"
  else
    notify-send -e -u low \
      -h int:value:"$vol" \
      -h string:x-canonical-private-synchronous:volume_notif \
      "Volume: ${vol}%"
  fi
}

# Actions
inc() {
  [ "$muted" = "true" ] && pamixer -u
  pamixer -i "$step"
  update_state
  notify
}

dec() {
  [ "$muted" = "true" ] && pamixer -u
  pamixer -d "$step"
  update_state
  notify
}

toggle() {
  pamixer -t
  update_state
  notify
}

# Command-line actions (dwm keybindings)
case "$1" in
up)
  inc
  refresh
  exit
  ;;
down)
  dec
  refresh
  exit
  ;;
mute)
  toggle
  refresh
  exit
  ;;
esac

# Click handling (dwmblocks-async)
case "$BLOCK_BUTTON" in
1) toggle ;;                                  # left click   → mute/unmute
3) setsid -f st -e wiremix >/dev/null 2>&1 ;; # right click  → TUI mixer
4) inc ;;                                     # scroll up    → +5%
5) dec ;;                                     # scroll down  → -5%
esac

# Icon
if [ "$muted" = "true" ] || [ "$vol" -eq 0 ]; then
  icon="󰝟"
elif [ "$vol" -le 30 ]; then
  icon="󰕿"
elif [ "$vol" -le 60 ]; then
  icon="󰖀"
else
  icon="󰕾"
fi

# Output
if [ "$muted" = "true" ] || [ "$vol" -eq 0 ]; then
  printf "%s\n" "$icon"
else
  printf "%s %s%%\n" "$icon" "$vol"
fi
