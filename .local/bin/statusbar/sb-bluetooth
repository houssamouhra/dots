#!/bin/sh
# Bluetooth status for dwmblocks-async: "󰂱 2"

powered=$(timeout 2 bluetoothctl show 2>/dev/null | awk '/Powered:/ {print $2; exit}')

# Off (or no controller / bluetoothd not running)
[ "$powered" = "yes" ] || {
    printf "󰂲\n"
    exit 0
}

count=$(timeout 2 bluetoothctl devices Connected 2>/dev/null | grep -c '^Device ')

if [ "$count" -gt 0 ]; then
    printf "󰂱 %s\n" "$count"
else
    printf "󰂯\n"
fi
