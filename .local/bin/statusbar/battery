#!/bin/sh

for battery in /sys/class/power_supply/BAT*; do
    [[ -f "$battery/capacity" ]] || continue

    capacity=$(<"$battery/capacity")
    status=$(<"$battery/status")

    case "$status" in
        Charging) icon="󰂄" ;;
        Full)     icon="󰁹" ;;
        *)        icon="󰁿" ;;
    esac

    printf '%s %s%%' "$icon" "$capacity"
    exit
done

printf '󰂑 N/A'
