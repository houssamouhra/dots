#!/bin/sh

# volume status for dwmblocks-async

# helpers
get_vol() {
  pamixer --get-volume
}

is_muted() {
  [ "$(pamixer --get-mute)" = "true" ]
}

# Dynamic Nerd Font icon
get_icon() {
  vol=$(get_vol)

  if is_muted || [ "$vol" -eq 0 ]; then
    echo "󰝟" # muted
  elif [ "$vol" -le 30 ]; then
    echo "󰕿" # low
  elif [ "$vol" -le 60 ]; then
    echo "󰖀" # medium
  else
    echo "󰕾" # high
  fi
}

notify() {
  # Only notify if notify-send exists
  command -v notify-send >/dev/null 2>&1 || return

  vol=$(get_vol)
  icon=$(get_icon)

  if is_muted || [ "$vol" -eq 0 ]; then
    notify-send \
      -e \
      -h string:x-canonical-private-synchronous:volume_notif \
      -u low \
      "Volume: Muted"

  else
    notify-send \
      -e \
      -h int:value:"$vol" \
      -h string:x-canonical-private-synchronous:volume_notif \
      -u low \
      "Volume: ${vol}%"
  fi
}

# actions
inc() {
  is_muted && pamixer -u
  pamixer -i 5
  notify
}

dec() {
  is_muted && pamixer -u
  pamixer -d 5
  notify
}

toggle() {
  pamixer -t
  notify
}

#  click handling (dwmblocks-async)
case $BLOCK_BUTTON in
1) toggle ;;                                    # left click  → mute/unmute
3) setsid -f st -e wiremix >/dev/null 2>&1 & ;; # right → TUI
4) inc ;;                                       # scroll up   → +5%
5) dec ;;                                       # scroll down → -5%
esac

#  statusbar output
icon=$(get_icon)
vol=$(get_vol)

if is_muted || [ "$vol" -eq 0 ]; then
  printf "%s" "$icon"
else
  printf "%s %s%%" "$icon" "$vol"
fi
