#!/bin/sh

# CPU usage for dwmblocks-async

cache="${XDG_CACHE_HOME:-$HOME/.cache}/dwmblocks-cpu"

# Read current stats
read -r _ user nice system idle iowait irq softirq steal _ </proc/stat

total=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle_all=$((idle + iowait))

if [ -f "$cache" ]; then
    read -r old_total old_idle <"$cache"

    delta_total=$((total - old_total))
    delta_idle=$((idle_all - old_idle))

    if [ "$delta_total" -gt 0 ]; then
        usage=$(((100 * (delta_total - delta_idle)) / delta_total))
        printf "%s%% 󰍛" "$usage"
    else
        printf "-- 󰍛"
    fi
else
    printf "-- 󰍛"
fi

# Save current values for next run
printf "%s %s\n" "$total" "$idle_all" >"$cache"
