[global]
font = Maple Mono NF 12
frame_width = 1
frame_color = "#565f89"
separator_color = frame
background = "#16161e"
foreground = "#c0caf5"

width = 350
height = 300
origin = top-right
offset = 5x25
padding = 15
horizontal_padding = 15
text_icon_padding = 10

corner_radius = 0
gap_size = 5

markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center

show_icons = yes
max_icon_size = 60
icon_position = left
icon_path = /usr/share/icons/Adwaita

indicate_hidden = yes
stack_duplicates = true
hide_duplicate_count = false

timeout = 4
ignore_newline = no

mouse_left_click = do_action
mouse_middle_click = close_current
mouse_right_click = close_all

[urgency_low]
background = "#16161e"
foreground = "#c0caf5"
timeout = 3

[urgency_normal]
background = "#16161e"
foreground = "#c0caf5"
timeout = 4

[urgency_critical]
background = "#16161e"
foreground = "#c0caf5"
frame_color = "#f7768e"
timeout = 8

[app-name="Telegram Desktop"]
timeout = 5
ignore_timeout = yes

[app-name="Thunderbird"]
timeout = 5
ignore_timeout = yes
