#!/bin/sh
# Battery status for dwmblocks-async: "󰁹 85%"
# Prints nothing when there is no battery (desktop).

for bat in /sys/class/power_supply/BAT*; do
    [ -r "$bat/capacity" ] || continue

    read -r capacity <"$bat/capacity"
    read -r status <"$bat/status" 2>/dev/null

    case "$status" in
    Charging)
        icon="󰂄"
        ;;
    Full | "Not charging")
        # Plugged in and not charging (full or held at a charge threshold)
        icon="󰁹"
        ;;
    *)
        # Discharging / Unknown: icon by percentage
        if [ "$capacity" -ge 90 ]; then
            icon="󰁹"
        elif [ "$capacity" -ge 70 ]; then
            icon="󰂁"
        elif [ "$capacity" -ge 50 ]; then
            icon="󰁿"
        elif [ "$capacity" -ge 30 ]; then
            icon="󰁽"
        elif [ "$capacity" -ge 15 ]; then
            icon="󰁻"
        else
            icon="󰂎"
        fi
        ;;
    esac

    printf "%s %s%%\n" "$icon" "$capacity"
    exit 0
done

# No battery found: print nothing so the block is hidden
exit 0
