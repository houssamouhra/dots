#!/bin/sh
# Network status for dwmblocks-async: "󰤨"

case "$BLOCK_BUTTON" in
1) setsid -f st -e cmtui >/dev/null 2>&1 ;; # left click → network TUI
esac

eth_linked=0

# Ethernet (preferred when it has an IP)
for dev in /sys/class/net/e*; do
    [ -e "$dev" ] || continue
    [ "$(cat "$dev/operstate" 2>/dev/null)" = "up" ] || continue
    if ip -4 addr show dev "${dev##*/}" | grep -q "inet "; then
        printf "󰌘\n"
        exit 0
    fi
    eth_linked=1
done

# Wi-Fi
for dev in /sys/class/net/w*; do
    [ -e "$dev" ] || continue
    wlan=${dev##*/}
    state=$(cat "$dev/operstate" 2>/dev/null)

    if [ "$state" = "up" ]; then
        # Link quality as 0-100
        quality=$(awk -v d="$wlan:" '$1 == d { print int($3 * 100 / 70) }' /proc/net/wireless 2>/dev/null)
        quality=${quality:-0}

        if [ "$quality" -ge 80 ]; then
            icon="󰤨" # excellent
        elif [ "$quality" -ge 60 ]; then
            icon="󰤥" # good
        elif [ "$quality" -ge 40 ]; then
            icon="󰤢" # ok
        elif [ "$quality" -ge 20 ]; then
            icon="󰤟" # weak
        else
            icon="󰤯" # very weak
        fi
        printf "%s\n" "$icon"
        exit 0
    fi

    # Interface down: administratively down (bit 0x1 clear) = disabled/rfkill
    flags=$(cat "$dev/flags" 2>/dev/null)
    if [ -n "$flags" ] && [ $((flags & 1)) -eq 0 ]; then
        printf "󰤫\n" # wifi disabled
    else
        printf "󰤮\n" # enabled but not connected
    fi
    exit 0
done

# No usable Wi-Fi interface
if [ "$eth_linked" -eq 1 ]; then
    printf "󰈁\n" # ethernet linked but no IP
else
    printf "󰌙\n" # fully disconnected
fi
