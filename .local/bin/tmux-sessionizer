#!/bin/sh

DIRECTORIES="
	$HOME/Projects
	$HOME/practice
	$HOME/Documents
	$HOME
"

switch_to() {
	if [ -z "$TMUX" ]; then
		tmux attach-session -t "$1"
	else
		tmux switch-client -t "$1"
	fi
}

has_session() {
	tmux list-sessions | grep -q "^$1:"
}

hydrate() {
	if [ -f "$2/.tmux-sessionizer" ]; then
		tmux send-keys -t "$1" "source $2/.tmux-sessionizer" c-M
	elif [ -f "$XDG_CONFIG_HOME/tmux-sessionizer/default" ]; then
		tmux send-keys -t "$1" "source $XDG_CONFIG_HOME/tmux-sessionizer/default" c-M
	fi
}

configure_session() {
	session="$1"
}

if [ "$#" -eq 1 ]; then
	selected="$1"
else
	selected=$(
		for dir in $DIRECTORIES; do
			find "$dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
		done | fzf \
			--style minimal \
			--no-bold \
			--height=100% \
			--no-unicode \
			--no-color
	)
fi

[ -z "$selected" ] && exit 0

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [ -z "$TMUX" ] && [ -z "$tmux_running" ]; then
	tmux new-session -ds "$selected_name" -c "$selected"
	configure_session "$selected_name"
	hydrate "$selected_name" "$selected"
fi

if ! has_session "$selected_name"; then
	tmux new-session -ds "$selected_name" -c "$selected"
	configure_session "$selected_name"
	hydrate "$selected_name" "$selected"
fi

switch_to "$selected_name"
